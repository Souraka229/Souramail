# ─── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Public base URL of apps/api (shown in the dashboard + OpenAPI servers).
API_PUBLIC_URL=http://localhost:4000

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
# App connects with a NON-superuser role so RLS is enforced (see infra/docker-compose.yml).
# DATABASE_URL = pooled connection (runtime). DIRECT_URL = non-pooled (migrations / codegen).
# Local dev: DIRECT_URL unset → migrate falls back to MIGRATION_DATABASE_URL (owner role).
# Staging (Neon): set both — see .env.staging / docs/PROVISIONING.md.
DATABASE_URL=postgres://souramail_app:souramail_app@localhost:5432/souramail
DIRECT_URL=
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/souramail

# ─── Redis (cache / rate-limit / BullMQ) ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Object storage (MinIO locally, R2/S3 in prod) ─────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=souramail-mail
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── Mail edge (local dev containers · profile `mail`) ─────────────────────
MAIL_HOSTNAME=mx1.localhost
STALWART_ADMIN_URL=http://localhost:8080
STALWART_JMAP_URL=http://localhost:8080/jmap
STALWART_ADMIN_USER=admin
STALWART_ADMIN_SECRET=change-me-in-prod
# TLS_CERT / TLS_KEY: prod only — paths inside the Stalwart container to your certs.

# MTA hook: Stalwart POSTs accepted inbound mail here; apps/api enqueues inbound-process.
MTA_HOOK_URL=http://host.docker.internal:4000/hooks/stalwart/inbound
MTA_HOOK_SECRET=dev-mta-hook-secret

# Webmail: AES-256-GCM key (32 bytes base64) for the per-mailbox JMAP credential
# at rest. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAIL_SECRET_KEY=

# Managed inbound webhook (Cloudflare Email Routing Worker / SES Inbound / other):
# bearer secret the sender must present to POST /api/webhooks/email-inbound.
# Not needed once Stalwart's MTA hook is the inbound path.
INBOUND_WEBHOOK_SECRET=

# ─── AI Gateway (LiteLLM) ─────────────────────────────────────────────────
AI_GATEWAY_URL=http://localhost:4001
AI_GATEWAY_KEY=dev-local-key

# ─── Auth (Better Auth + Better Auth Infra) ──────────────────────────────
# Served by apps/web at /api/auth/*. BETTER_AUTH_URL = the deployed web app URL.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
BETTER_AUTH_API_KEY=            # from the Better Auth Infra dashboard (rotate if leaked)

# ─── Observability ────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# ─── EmailProvider (phases 1-4: managed SMTP relay) ───────────────────────
EMAIL_PROVIDER=smtp-relay
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
SMTP_RELAY_USER=
SMTP_RELAY_PASS=

# ─── DnsProvider ─────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

{
  "name": "souramail",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @souramail/db generate",
    "db:migrate": "pnpm --filter @souramail/db migrate",
    "db:studio": "pnpm --filter @souramail/db studio",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down && rm -rf infra/.data && docker compose -f infra/docker-compose.yml up -d"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "turbo": "^2.5.4",
    "typescript": "^5.7.3"
  }
}
